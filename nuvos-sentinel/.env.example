# Where to poll — the main Nuvos backend (Railway) and public web frontend.
NUVOS_BACKEND_URL=https://api.nuvosai.com
NUVOS_WEB_URL=https://nuvosai.com

# Must match SENTINEL_SHARED_SECRET set in the main backend's Railway env.
# Generate a random value once, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
SENTINEL_SHARED_SECRET=

# Twilio — this service's OWN credentials, separate from the main backend's,
# so an alert can go out even if the main backend/Supabase is fully down.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE_NUMBER=+10000000000

# WhatsApp via Kapso — set ALERT_WHATSAPP_PROVIDER=kapso to use this INSTEAD
# of Twilio SMS above. Requires a Meta-approved message template (see
# README's "WhatsApp via Kapso" section) — WhatsApp does not allow sending
# an unprompted plain-text message outside a 24h conversation window.
ALERT_WHATSAPP_PROVIDER=twilio
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_TEMPLATE_NAME=nuvos_alert
KAPSO_TEMPLATE_LANG=es_MX
ALERT_WHATSAPP_NUMBER=+10000000000

# Resend — same reasoning, own API key.
RESEND_API_KEY=
ALERT_EMAIL=diego.arria19@gmail.com

# Dashboard login (HTTP Basic) — not tied to Supabase.
SENTINEL_DASHBOARD_USER=admin
SENTINEL_DASHBOARD_PASSWORD=

# Optional tuning (defaults shown).
# POLL_INTERVAL_SECONDS=120
# CONSECUTIVE_FAILS_TO_ALERT=3
# REALERT_INTERVAL_SECONDS=1800
# SECURITY_METRICS_WINDOW_MINUTES=15
# LOGIN_FAILED_THRESHOLD=50
# RATE_LIMIT_DISTINCT_IP_THRESHOLD=20
# CLIENT_ERROR_SPIKE_THRESHOLD=15
# FRONTEND_EXPECTED_MARKER=Nuvos
# SENTINEL_DB_PATH=sentinel.db
